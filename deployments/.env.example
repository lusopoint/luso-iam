# Copy to .env (sibling to docker-compose.yml) and fill in real values
# Most vars are required and Compose will refuse to start without them
#
# For the full list of every env var the LusoIAM server reads, see the
# project roots .env.example. This file is the minimal set needed for docker-compose deployment


# Secrets
#
# Generate fresh for each environment. NEVER reuse across staging/prod.
#
#   POSTGRES_PASSWORD: openssl rand -hex 24
#   SESSION_SECRET:    openssl rand -hex 32
#
POSTGRES_PASSWORD=
SESSION_SECRET=

# db information and configuration
DATABASE_URL=postgres://iam:iam@localhost:5432/iam?sslmode=disable
# set false when you run more than one replica, then run /migrate once
AUTO_MIGRATE=true
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=1h

# DNS / public URL
# BASE_URL=https://auth.example.com

# port for the application to run
HTTP_ADDR=:8080
# log information and types
LOG_LEVEL=info
LOG_FORMAT=text
ENV=prod

# the signing key path
SIGNING_KEY_PATH=/etc/iam/signing.pem

# We can disable sign-up/registration
SIGNUP_ENABLED=true

# Gives us metrics on the application
METRICS_ENABLED=true

# SMTP
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# reverse proxy
# LusoIAM can act as the gatekeeper for the reverse proxy (like caddy or traefik)
#
# make the LusoIAM session cookie readable across all subdomains under the parent
# without this, the cookie is scoped to auth.example.com only and the
# forward_auth sub-request gets no cookie to validate
#SESSION_COOKIE_DOMAIN=.example.com
# Every protected origin that may be redirected back to after login.
# Comma-separated. Anything not in this list will see a bare 401 with no
# Location header (no infinite redirect loop, but the UX is ugly)
#PROXY_ALLOWED_CALLBACK_ORIGINS=https://app.example.com,https://wiki.example.com

# branding
# display name shown in TOTP authenticator apps
MFA_ISSUER="LusoIAM (dev)"
# relying party name shown in WebAuthn / passkey prompts
MFA_WEBAUTHN_RP_NAME="LusoIAM"
# make MFA mandatory for every user
FORCE_MFA=false

# Federation (optional)
#
# Set the values in this file. Compose passes every variable in this file to
# the container, so the generic OIDC_<SLUG>_* variables work without a Compose
# edit.
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# OIDC_PROVIDERS=microsoft,okta
# OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_OKTA_ISSUER=https://acme.okta.com
# OIDC_OKTA_CLIENT_ID=
# OIDC_OKTA_CLIENT_SECRET=

# Postgres user / DB (optional)
#
# Defaults to user=iam, db=iam — fine for almost everyone. Override if
# your DB conventions require something else.
# POSTGRES_USER=iam
# POSTGRES_DB=iam

# init an admin user on first build
ADMIN_EMAIL=auth-admin@lusopoint.com
ADMIN_PASSWORD=password1234
ADMIN_NAME=admin
ADMIN_USERNAME=admin

# enable documentation
DOCS_ENABLED=true
