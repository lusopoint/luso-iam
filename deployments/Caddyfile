# Caddyfile for the production IAM server deployment
#
# Replace `auth.example.com` below with your real DNS name before
# bringing the stack up. Caddy will request a Let's Encrypt cert on
# the first request to that hostname, automatically renewing every 60
# days thereafter.
#
# If your VM has email contact configured for ACME, prefer using the
# global directive instead of leaving it implicit:
#
#     {
#         email ops@example.com
#     }
#
# at the top of the file. Let's Encrypt uses this for cert-expiry
# notifications and abuse contact.

auth.example.com {
    reverse_proxy iam:8080

    # Tell IAM the request was originally HTTPS so cookies get the
    # Secure flag and OIDC discovery uses the public URL.
    # Caddy sets X-Forwarded-Proto/X-Forwarded-Host automatically.

    encode zstd gzip

    # Headers: IAM sets its own CSP / X-Content-Type-Options etc., but
    # we add HSTS at the edge so the browser pins HTTPS for future visits.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        format json
        output stdout
    }
}

