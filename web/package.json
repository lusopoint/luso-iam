{
  "name": "iam-server-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Admin SPA for the IAM server. Compiled output lives in web/dist and is embedded in the Go binary.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@lusopoint/luso-ui": "^1.2.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.477.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
